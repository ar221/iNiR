#!/usr/bin/env python3
"""Install/restore an iNiR-on-KWin shortcut profile.

This is intentionally file-based: it writes KDE's kglobalshortcutsrc and
creates small .desktop launchers for iNiR shell IPC actions. It does not
require full Plasma Settings.
"""
from __future__ import annotations

import argparse
import difflib
import os
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config" / "kglobalshortcutsrc"
APPDIR = HOME / ".local" / "share" / "applications"
STATE = HOME / ".local" / "state" / "inir-kwin"
BACKUP_DIR = STATE / "hotkey-backups"
MAP_FILE = STATE / "hotkeys.md"
INIR = "/home/ayaz/.local/bin/inir"

# group, key, value. KDE shortcut tuple format is: active,default,description.
KWIN_ENTRIES = [
    ("kwin", "Window Close", "Meta+Q,Alt+F4,Close Window"),
    ("kwin", "Window Fullscreen", "Meta+F,none,Make Window Fullscreen"),
    ("kwin", "Window Maximize", "Meta+D,Meta+PgUp,Maximize Window"),
    ("kwin", "Window Quick Tile Left", "Meta+Left,Meta+Left,Quick Tile Window to the Left"),
    ("kwin", "Window Quick Tile Right", "Meta+Right,Meta+Right,Quick Tile Window to the Right"),
    ("kwin", "Window Quick Tile Top", "Meta+Up,Meta+Up,Quick Tile Window to the Top"),
    ("kwin", "Window Quick Tile Bottom", "Meta+Down,Meta+Down,Quick Tile Window to the Bottom"),
    ("kwin", "Walk Through Windows", "Alt+Tab,Alt+Tab,Walk Through Windows"),
    ("kwin", "Walk Through Windows (Reverse)", "Alt+Shift+Tab,Alt+Shift+Tab,Walk Through Windows (Reverse)"),
    ("kwin", "Overview", "Meta+W,Meta+W,Toggle Overview"),
    ("kwin", "Grid View", "Meta+Ctrl+W,Meta+G,Toggle Grid View"),
    ("kwin", "Switch to Desktop 1", "Meta+1,Ctrl+F1,Switch to Desktop 1"),
    ("kwin", "Switch to Desktop 2", "Meta+2,Ctrl+F2,Switch to Desktop 2"),
    ("kwin", "Switch to Desktop 3", "Meta+3,Ctrl+F3,Switch to Desktop 3"),
    ("kwin", "Switch to Desktop 4", "Meta+4,Ctrl+F4,Switch to Desktop 4"),
    ("kwin", "Switch to Desktop 5", "Meta+5,none,Switch to Desktop 5"),
    ("kwin", "Switch to Desktop 6", "Meta+6,none,Switch to Desktop 6"),
    ("kwin", "Switch to Desktop 7", "Meta+7,none,Switch to Desktop 7"),
    ("kwin", "Switch to Desktop 8", "Meta+8,none,Switch to Desktop 8"),
    ("kwin", "Switch to Desktop 9", "Meta+9,none,Switch to Desktop 9"),
]

# desktop id, key, visible name, command args after INIR
INIR_ACTIONS = [
    ("inir-kwin-overview.desktop", "Meta+Space", "iNiR Overview", ["overview", "toggle"]),
    ("inir-kwin-overlay.desktop", "Meta+G", "iNiR Overlay", ["overlay", "toggle"]),
    ("inir-kwin-clipboard.desktop", "Meta+V", "iNiR Clipboard", ["clipboard", "toggle"]),
    ("inir-kwin-courier-rail.desktop", "Meta+Backslash", "iNiR Courier Rail", ["courierRail", "toggle"]),
    ("inir-kwin-lock.desktop", "Meta+Alt+L", "iNiR Lock", ["lock", "activate"]),
    ("inir-kwin-region-screenshot.desktop", "Meta+Shift+S", "iNiR Region Screenshot", ["region", "screenshot"]),
    ("inir-kwin-region-ocr.desktop", "Meta+Shift+X", "iNiR Region OCR", ["region", "ocr"]),
    ("inir-kwin-region-search.desktop", "Meta+Shift+A", "iNiR Region Search", ["region", "search"]),
    ("inir-kwin-wallpaper-selector.desktop", "Ctrl+Alt+T", "iNiR Wallpaper Selector", ["wallpaperSelector", "toggle"]),
    ("inir-kwin-settings.desktop", "Meta+Comma", "iNiR Settings", ["settings"]),
    ("inir-kwin-cheatsheet.desktop", "Meta+Slash", "iNiR Cheatsheet", ["cheatsheet", "toggle"]),
    ("inir-kwin-command-room.desktop", "Meta+F9", "iNiR Command Room", ["command-room-panel", "toggle"]),
    ("inir-kwin-panel-family.desktop", "Meta+Shift+W", "iNiR Panel Family Cycle", ["panelFamily", "cycle"]),
    ("inir-kwin-session-menu.desktop", "Meta+Shift+Q", "iNiR Session Menu", ["session", "toggle"]),
    ("inir-kwin-clear-notifications.desktop", "Meta+Shift+D", "iNiR Clear Notifications", ["notifications", "clearAll"]),
    ("inir-kwin-sidebar-left.desktop", "Meta+Backspace", "iNiR Left Sidebar", ["sidebarLeft", "toggle"]),
    ("inir-kwin-sidebar-right.desktop", "Meta+Shift+Backspace", "iNiR Right Sidebar", ["sidebarRight", "toggle"]),
    ("inir-kwin-dashboard.desktop", "Meta+Shift+Backslash", "iNiR Dashboard", ["dashboard", "toggle"]),
    ("inir-kwin-terminal.desktop", "Meta+Return", "iNiR Terminal", ["terminal"]),
    ("inir-kwin-browser.desktop", "Meta+B", "Open Browser", ["browser"]),
    ("inir-kwin-audio-up.desktop", "Volume Up", "iNiR Volume Up", ["audio", "volumeUp"]),
    ("inir-kwin-audio-down.desktop", "Volume Down", "iNiR Volume Down", ["audio", "volumeDown"]),
    ("inir-kwin-audio-mute.desktop", "Volume Mute", "iNiR Volume Mute", ["audio", "mute"]),
    ("inir-kwin-mic-mute.desktop", "Microphone Mute", "iNiR Mic Mute", ["audio", "micMute"]),
    ("inir-kwin-media-playpause.desktop", "Media Play", "iNiR Play/Pause", ["mpris", "playPause"]),
    ("inir-kwin-media-next.desktop", "Media Next", "iNiR Next Track", ["mpris", "next"]),
    ("inir-kwin-media-prev.desktop", "Media Previous", "iNiR Previous Track", ["mpris", "previous"]),
