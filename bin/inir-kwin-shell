#!/usr/bin/env bash
set -euo pipefail

# Child session for the iNiR-on-KWin prototype.
# KWin starts this with --exit-with-session once its Wayland socket is ready.
# Keep it foregrounded: when Quickshell exits, KWin exits too.

export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-inir-kwin}"
export DESKTOP_SESSION="${DESKTOP_SESSION:-inir-kwin}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-KDE:inir}"
export KDE_FULL_SESSION="${KDE_FULL_SESSION:-true}"
export KDE_SESSION_VERSION="${KDE_SESSION_VERSION:-6}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-kde}"
export QT_WAYLAND_RECONNECT="${QT_WAYLAND_RECONNECT:-1}"

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user import-environment \
    WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
    DESKTOP_SESSION XDG_CURRENT_DESKTOP KDE_FULL_SESSION KDE_SESSION_VERSION \
    QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_WAYLAND_RECONNECT 2>/dev/null || true
fi

exec /home/ayaz/.local/bin/inir run --session
